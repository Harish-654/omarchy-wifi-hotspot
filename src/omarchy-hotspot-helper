#!/usr/bin/env bash
# omarchy-hotspot-helper: concurrent Wi-Fi hotspot for the local.hotspot bar
# plugin. The station interface stays connected to the current network while
# a virtual AP interface (ap0) serves clients via hostapd + dnsmasq. Traffic
# is NATed through the default route, so any uplink (Ethernet, tether,
# VLAN-tagged interface, or the Wi-Fi network itself) is shared.
#
# Hardware constraint: Single-PHY radios (e.g. Realtek rtw89_8852be, Intel iwlwifi)
# can only operate on 1 channel at a time (#channels <= 1). The AP MUST mirror
# the station's channel & bandwidth while Wi-Fi is connected, and must be paused
# while the station is roaming/reassociating so scanning on other bands is not blocked.
#
# Channel and frequency band are configurable: use "auto" (default) to mirror
# the station, or pick a specific channel/band.
#
# Started via pkexec by the panel; a polkit rule makes that passwordless.
set -euo pipefail

VIF="ap0"
RUN_DIR="/run/omarchy-hotspot"
STATE_DIR="/var/lib/omarchy-hotspot"
PASS_FILE="$STATE_DIR/password"
SSID_FILE="$STATE_DIR/ssid"
FREQ_FILE="$STATE_DIR/freq-band"
CHAN_FILE="$STATE_DIR/channel"
AP_CONF="$RUN_DIR/hostapd.conf"
AP_PID="$RUN_DIR/hostapd.pid"
AP_SUBNET="10.42.0.0/24"
AP_GATEWAY="10.42.0.1"

station_iface() {
  # Exclude the AP vif itself ($VIF) -- nmcli lists it as TYPE wifi too
  # (just STATE=unmanaged), so without this filter a lucky/unlucky device
  # ordering could make the AP interface mistake itself for the station,
  # which would corrupt the channel-mirroring and watchdog fingerprint logic.
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | grep -E ':wifi$' | grep -v "^${VIF}:" | head -1 | cut -d: -f1
}

station_connected() {
  # NetworkManager's view of whether the station iface is actually
  # associated to a network right now. `iw dev info` alone is not
  # trustworthy for this: after a failed roam/reassociation the driver can
  # keep reporting a stale ssid/channel/width for an interface NM has
  # already given up on and shows as disconnected -- mirroring that ghost
  # data corrupts the AP's channel/HT config and the vif fails to come up
  # ("kernel reports: Match already configured").
  local iface="$1"
  [ -n "$iface" ] || return 1
  [ "$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep "^${iface}:" | cut -d: -f2)" = "connected" ]
}

station_channel() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  station_connected "$iface" || return 0
  iw dev "$iface" info 2>/dev/null | awk '/channel/ { print $2; exit }'
}

station_width() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  station_connected "$iface" || return 0
  iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "width:") { print $(i + 1); exit } }'
}

station_center_offset() {
  local iface ch primary center
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  ch="$(station_channel)"
  [ -n "$ch" ] || return 0
  center="$(iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "center1:") { print $(i + 1); exit } }')"
  [ -n "$center" ] || return 0
  if [ "$ch" -le 14 ]; then
    primary=$((2412 + (ch - 1) * 5))
  else
    primary=$((5000 + ch * 5))
  fi
  if [ "$center" -gt "$primary" ]; then
    echo "plus"
  elif [ "$center" -lt "$primary" ]; then
    echo "minus"
  fi
}

station_vht_center() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  station_connected "$iface" || return 0
  iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "center1:") { print $(i + 1); exit } }'
}

config_freq_band() {
  if [ -s "$FREQ_FILE" ]; then
    cat "$FREQ_FILE"
  else
    echo "auto"
  fi
}

config_channel() {
  if [ -s "$CHAN_FILE" ]; then
    cat "$CHAN_FILE"
  else
    echo "0"
  fi
}

freq_to_channel() {
  local freq=$1
  if [ "$freq" -lt 3000 ]; then
    echo $(( (freq - 2407) / 5 ))
  else
    echo $(( (freq - 5000) / 5 ))
  fi
}

ap_ssid() {
  if [ -s "$SSID_FILE" ]; then
    cat "$SSID_FILE"
  else
    echo "OmarchyHotspot"
  fi
}

vif_exists() {
  iw dev "$VIF" info >/dev/null 2>&1
}

hotspot_on() {
  systemctl is-active --quiet omarchy-hotspot 2>/dev/null
}

real_user() {
  if [ -n "${PKEXEC_UID:-}" ]; then
    id -nu "$PKEXEC_UID"
  elif [ -n "${SUDO_USER:-}" ]; then
    echo "$SUDO_USER"
  elif logname >/dev/null 2>&1; then
    logname
  else
    id -un
  fi
}

protect_passfile() {
  chown "$(real_user)" "$PASS_FILE" 2>/dev/null || true
  chmod 600 "$PASS_FILE"
  if [ -f "$SSID_FILE" ]; then
    chown "$(real_user)" "$SSID_FILE" 2>/dev/null || true
    chmod 644 "$SSID_FILE" 2>/dev/null || true
  fi
  for f in "$FREQ_FILE" "$CHAN_FILE"; do
    if [ -f "$f" ]; then
      chown "$(real_user)" "$f" 2>/dev/null || true
      chmod 644 "$f" 2>/dev/null || true
    fi
  done
}

ensure_state() {
  mkdir -p "$STATE_DIR" "$RUN_DIR"
  chmod 755 "$STATE_DIR"
  chmod 700 "$RUN_DIR"
  if [ ! -s "$PASS_FILE" ]; then
    tr -dc 'A-Za-z0-9' </dev/urandom | head -c 10 >"$PASS_FILE" || true
  fi
  if [ ! -s "$SSID_FILE" ]; then
    echo "OmarchyHotspot" >"$SSID_FILE" || true
  fi
  protect_passfile
}

cleanup_vif() {
  systemctl stop omarchy-hotspot 2>/dev/null || true
  ip link set "$VIF" down 2>/dev/null || true
  iw dev "$VIF" del 2>/dev/null || true
}

ensure_vif() {
  local iface phy base_mac ap_mac
  iface="$(station_iface)"
  [ -n "$iface" ] || { echo "no-wifi-device" >&2; return 1; }
  phy="phy$(iw dev "$iface" info 2>/dev/null | awk '/wiphy/ { print $2; exit }')"
  [ -n "$phy" ] || phy="phy0"

  # NetworkManager can leave the driver holding a stale association (still
  # reporting an old ssid/channel/width via `iw`) after a failed roam even
  # though NM itself shows the device as disconnected -- e.g. when the user
  # is on Ethernet/another uplink and Wi-Fi never cleanly let go. On a
  # single-channel-context radio (#channels <= 1) that ghost association
  # pins the whole phy to its old channel and the AP vif fails to come up
  # ("kernel reports: Match already configured"). Force a clean disconnect
  # whenever NM doesn't consider the station actually connected.
  if ! station_connected "$iface"; then
    iw dev "$iface" disconnect 2>/dev/null || true
  fi

  if ! vif_exists; then
    iw phy "$phy" interface add "$VIF" type __ap 2>/dev/null || true
    for _ in $(seq 1 10); do
      vif_exists && break
      sleep 0.1
    done
  fi

  if ! vif_exists; then
    echo "vif-create-timeout" >&2
    return 1
  fi

  # Realtek rtw89 and other drivers fail with 'kernel reports: Match already configured'
  # if ap0 has the exact same MAC as the station interface.
  # Set a locally-administered unicast address (02:...).
  base_mac="$(cat "/sys/class/net/$iface/address" 2>/dev/null || true)"
  if [ -n "$base_mac" ]; then
    ap_mac="02${base_mac:2}"
    ip link set "$VIF" down 2>/dev/null || true
    ip link set "$VIF" address "$ap_mac" 2>/dev/null || true
  fi
  return 0
}

get_available_channels() {
  local band="${1:-auto}"
  iw list 2>/dev/null | awk -v band="$band" '
    /Frequencies:/ { in_f=1; next }
    /^[ \t]*Band [0-9]/ { in_f=0 }
    in_f && /\[[0-9]+\]/ {
      for (i=1; i<=NF; i++) {
        if ($i ~ /^\[[0-9]+\]$/) {
          ch=$i; gsub(/[^0-9]/, "", ch);
          if (ch > 0 && !seen[ch]++) {
            if ((band ~ /^2/ && ch <= 14) || (band ~ /^5/ && ch > 14) || (band == "auto")) {
              print ch
            }
          }
        }
      }
    }
  '
}

write_hostapd_conf() {
  local channel freq mode ht seg0 seg1 chwidth
  local conf_channel conf_freq_band

  conf_channel="$(config_channel)"
  conf_freq_band="$(config_freq_band)"

  if [ "$conf_channel" != "0" ]; then
    channel=$conf_channel
    if [ "$channel" -le 14 ]; then
      mode="g"
      freq=$((2412 + (channel - 1) * 5))
      ht="[HT20]"
    else
      mode="a"
      freq=$((5000 + channel * 5))
      ht="[HT40+]"
    fi
  elif [ "$conf_freq_band" != "auto" ]; then
    channel="$(station_channel)"
    [ -z "$channel" ] && channel=1
    case "$conf_freq_band" in
      2.4|2.4ghz)
        [ "$channel" -gt 14 ] && channel=6
        mode="g"
        freq=$((2412 + (channel - 1) * 5))
        ;;
      5|5ghz)
        [ "$channel" -le 14 ] && channel=36
        mode="a"
        freq=$((5000 + channel * 5))
        ;;
    esac
    case "$(station_width)" in
      40)
        if [ "$(station_center_offset)" = "minus" ]; then ht="[HT40-]"
        else ht="[HT40+]"; fi
        ;;
      80)
        ht="[HT40+]"; chwidth=1
        local vhtcenter80
        vhtcenter80="$(station_vht_center)"
        if [ -n "$vhtcenter80" ]; then seg0=$(((vhtcenter80 - 5000) / 5))
        else seg0=$(((freq + 20 - 5000) / 5)); fi
        ;;
      160)
        ht="[HT40+]"; chwidth=2
        local vhtcenter
        vhtcenter="$(station_vht_center)"
        seg0=$(((vhtcenter - 5000) / 5))
        if [ "$freq" -lt "$vhtcenter" ]; then
          seg1=$(((vhtcenter + 40 - 5000) / 5))
        else
          seg1=$(((vhtcenter - 40 - 5000) / 5))
        fi
        ;;
      *) ht="[HT20]" ;;
    esac
  else
    channel="$(station_channel)"
    [ -z "$channel" ] && channel=1
    if [ "$channel" -le 14 ]; then
      mode="g"
      freq=$((2412 + (channel - 1) * 5))
    else
      mode="a"
      freq=$((5000 + channel * 5))
    fi
    case "$(station_width)" in
      40)
        if [ "$(station_center_offset)" = "minus" ]; then ht="[HT40-]"
        else ht="[HT40+]"; fi
        ;;
      80)
        ht="[HT40+]"; chwidth=1
        local vhtcenter80
        vhtcenter80="$(station_vht_center)"
        if [ -n "$vhtcenter80" ]; then seg0=$(((vhtcenter80 - 5000) / 5))
        else seg0=$(((freq + 20 - 5000) / 5)); fi
        ;;
      160)
        ht="[HT40+]"; chwidth=2
        local vhtcenter
        vhtcenter="$(station_vht_center)"
        seg0=$(((vhtcenter - 5000) / 5))
        if [ "$freq" -lt "$vhtcenter" ]; then
          seg1=$(((vhtcenter + 40 - 5000) / 5))
        else
          seg1=$(((vhtcenter - 40 - 5000) / 5))
        fi
        ;;
      *) ht="[HT20]" ;;
    esac
  fi

  cat >"$AP_CONF" <<EOF
interface=$VIF
driver=nl80211
ssid=$(ap_ssid)
hw_mode=$mode
channel=$channel
wpa=2
wpa_passphrase=$(cat "$PASS_FILE")
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
ht_capab=$ht
${seg0:+ieee80211ac=1}
${seg0:+vht_oper_chwidth=$chwidth}
${seg0:+vht_oper_centr_freq_seg0_idx=$seg0}
${seg1:+vht_oper_centr_freq_seg1_idx=$seg1}
ignore_broadcast_ssid=0
EOF
  chmod 600 "$AP_CONF"
}

start_dns() {
  # DHCP / DNS
  local servers=()
  while read -r ns; do
    case "$ns" in
      127.*|::1|fe80:*|*%*|"") ;;
      *) servers+=(--server="$ns") ;;
    esac
  done < <(grep '^nameserver' /run/systemd/resolve/resolv.conf 2>/dev/null | awk '{print $2}' || true)
  if [ "${#servers[@]}" -eq 0 ]; then
    servers=(--server=1.1.1.1 --server=1.0.0.1)
  fi
  systemctl stop omarchy-hotspot-dns 2>/dev/null || true
  systemd-run --unit=omarchy-hotspot-dns --collect dnsmasq \
    --keep-in-foreground \
    --interface="$VIF" \
    --bind-interfaces \
    --except-interface=lo \
    --no-resolv \
    --log-dhcp \
    "${servers[@]}" \
    --dhcp-range=10.42.0.10,10.42.0.200,255.255.255.0,12h
}

# Best-effort UFW exception for the AP interface. iptables -I INPUT alone can
# be silently discarded by a later `ufw reload`/service (re)start, which
# re-applies ufw's own chains and drops anything inserted by other tools --
# this was observed live on this machine (kernel "[UFW BLOCK] IN=ap0 ..."
# entries persisting even with the raw iptables ACCEPT in place). Belt and
# suspenders: also add a real ufw rule when ufw is present, so the exception
# survives a ufw reload.
ufw_allow_vif() {
  command -v ufw >/dev/null 2>&1 || return 0
  ufw allow in on "$VIF" comment 'omarchy-hotspot' >/dev/null 2>&1 || true
}

ufw_deny_vif() {
  command -v ufw >/dev/null 2>&1 || return 0
  while ufw status numbered 2>/dev/null | grep -q "on $VIF"; do
    local num
    num="$(ufw status numbered 2>/dev/null | grep "on $VIF" | head -1 | grep -oE '^\[[0-9]+\]' | tr -d '[]')"
    [ -n "$num" ] || break
    yes | ufw delete "$num" >/dev/null 2>&1 || break
  done
}

recycle_ap() {
  cleanup_vif
  sleep 0.2
  if ! ensure_vif; then
    return 1
  fi
  if ! write_hostapd_conf; then
    return 1
  fi

  ip link set "$VIF" up 2>/dev/null || true
  systemctl stop omarchy-hotspot 2>/dev/null || true
  if ! systemd-run --unit=omarchy-hotspot --collect hostapd "$AP_CONF"; then
    cleanup_vif
    return 1
  fi
  sleep 1
  if ! systemctl is-active --quiet omarchy-hotspot; then
    cleanup_vif
    return 1
  fi
  ip addr replace "$AP_GATEWAY/24" dev "$VIF" 2>/dev/null || true
  ip link set "$VIF" up 2>/dev/null || true

  # The vif was deleted and recreated (new ifindex) -- dnsmasq's listening
  # socket from before the recycle may not survive that, so restart it too.
  # Without this, clients keep their hostapd/WPA association across a
  # roam-triggered recycle but silently lose DHCP/DNS.
  start_dns
  ufw_allow_vif
  return 0
}

start_ap() {
  ensure_state
  cleanup_vif
  sleep 0.2
  ensure_vif
  write_hostapd_conf

  ip link set "$VIF" up 2>/dev/null || true
  systemctl stop omarchy-hotspot 2>/dev/null || true
  if ! systemd-run --unit=omarchy-hotspot --collect hostapd "$AP_CONF"; then
    cleanup_vif
    exit 1
  fi
  sleep 1
  if ! systemctl is-active --quiet omarchy-hotspot; then
    echo "hostapd failed to start (journalctl -u omarchy-hotspot)" >&2
    cleanup_vif
    exit 1
  fi
  ip addr replace "$AP_GATEWAY/24" dev "$VIF" 2>/dev/null || true
  ip link set "$VIF" up 2>/dev/null || true

  # Start station watchdog to handle network/band/channel switches automatically.
  systemctl stop omarchy-hotspot-watch 2>/dev/null || true
  systemd-run --unit=omarchy-hotspot-watch --collect "$0" watch 2>/dev/null || true

  # NAT and firewall routing
  sysctl -q -w net.ipv4.ip_forward=1
  iptables -t nat -C POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE
  iptables -C FORWARD -i "$VIF" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD -i "$VIF" -j ACCEPT
  iptables -C FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT
  iptables -C INPUT -i "$VIF" -j ACCEPT 2>/dev/null \
    || iptables -I INPUT -i "$VIF" -j ACCEPT
  ufw_allow_vif

  start_dns
}

stop_ap() {
  systemctl stop omarchy-hotspot-watch 2>/dev/null || true
  systemctl stop omarchy-hotspot 2>/dev/null || true
  systemctl stop omarchy-hotspot-dns 2>/dev/null || true
  iptables -D INPUT -i "$VIF" -j ACCEPT 2>/dev/null || true
  iptables -t nat -D POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE 2>/dev/null || true
  iptables -D FORWARD -i "$VIF" -j ACCEPT 2>/dev/null || true
  iptables -D FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  ufw_deny_vif
  cleanup_vif
}

uplink_iface() {
  ip route get 8.8.8.8 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i == "dev") print $(i+1); exit }' || true
}

status_text() {
  if ! hotspot_on; then
    echo "off $(ap_ssid)"
    return
  fi
  local iface channel clients freq_band
  iface="$(station_iface)"
  channel="$(iw dev "$iface" info 2>/dev/null | awk '/channel/ { print $2; exit }')"
  if [ -z "$channel" ]; then
    channel="$(iw dev "$VIF" info 2>/dev/null | awk '/channel/ { print $2; exit }')"
  fi
  clients="$(iw dev "$VIF" station dump 2>/dev/null | grep -c '^Station' || true)"
  freq_band="$(config_freq_band)"
  echo "on $(ap_ssid) $(uplink_iface) ${freq_band} ${channel:-} ${clients:-0}"
}

set_password() {
  local newpass byte_len total printable
  IFS= read -r newpass
  if [ -z "$newpass" ]; then
    echo "No password provided on stdin" >&2
    return 1
  fi
  total="$(printf '%s' "$newpass" | wc -c)"
  printable="$(printf '%s' "$newpass" | LC_ALL=C tr -cd '[:print:]' | wc -c)"
  if [ "$total" -ne "$printable" ]; then
    echo "Password must contain only printable ASCII characters" >&2
    return 1
  fi
  byte_len="$(printf '%s' "$newpass" | wc -c)"
  if [ "$byte_len" -lt 8 ] || [ "$byte_len" -gt 63 ]; then
    echo "Password must be between 8 and 63 characters" >&2
    return 1
  fi
  ensure_state
  printf '%s' "$newpass" >"$PASS_FILE"
  protect_passfile
  if hotspot_on; then
    recycle_ap || { echo "hostapd failed to restart with the new password" >&2; return 1; }
  fi
  echo "ok"
}

set_ssid() {
  local newssid byte_len total printable
  IFS= read -r newssid
  if [ -z "$newssid" ]; then
    echo "No SSID provided on stdin" >&2
    return 1
  fi
  total="$(printf '%s' "$newssid" | wc -c)"
  printable="$(printf '%s' "$newssid" | LC_ALL=C tr -cd '[:print:]' | wc -c)"
  if [ "$total" -ne "$printable" ]; then
    echo "SSID must contain only printable characters" >&2
    return 1
  fi
  byte_len="$(printf '%s' "$newssid" | wc -c)"
  if [ "$byte_len" -lt 1 ] || [ "$byte_len" -gt 32 ]; then
    echo "SSID must be between 1 and 32 characters" >&2
    return 1
  fi
  ensure_state
  printf '%s' "$newssid" >"$SSID_FILE"
  protect_passfile
  if hotspot_on; then
    recycle_ap || { echo "hostapd failed to restart with the new SSID" >&2; return 1; }
  fi
  echo "ok"
}

set_freq_band() {
  local newband
  IFS= read -r newband
  case "$newband" in
    auto|2.4|2.4ghz|5|5ghz) ;;
    *) echo "Invalid frequency band: '$newband' (expected auto, 2.4, or 5)" >&2; return 1 ;;
  esac
  ensure_state
  printf '%s' "$newband" >"$FREQ_FILE"
  protect_passfile
  if hotspot_on; then
    recycle_ap || { echo "hostapd failed to restart with the new frequency band" >&2; return 1; }
  fi
  echo "ok"
}

set_channel() {
  local newchan
  IFS= read -r newchan
  case "$newchan" in
    0|auto) newchan="0" ;;
    [0-9]*)
      if ! [ "$newchan" -gt 0 ] 2>/dev/null; then
        echo "Invalid channel: '$newchan'" >&2
        return 1
      fi
      ;;
    *)
      echo "Invalid channel: '$newchan' (expected auto or 1-196)" >&2
      return 1
      ;;
  esac
  ensure_state
  printf '%s' "$newchan" >"$CHAN_FILE"
  protect_passfile
  if hotspot_on; then
    recycle_ap || { echo "hostapd failed to restart with the new channel" >&2; return 1; }
  fi
  echo "ok"
}

list_channels() {
  local band
  band="$(config_freq_band)"
  get_available_channels "$band"
}

station_fingerprint() {
  local iface channel center width freq
  iface="$(station_iface)"
  [ -n "$iface" ] || return 1
  channel="$(iw dev "$iface" info 2>/dev/null | awk '/channel/ { print $2; exit }')"
  if [ -z "$channel" ] || [ "$channel" = "N/A" ]; then
    return 1
  fi
  if [ "$channel" -le 14 ]; then
    freq=$((2412 + (channel - 1) * 5))
  else
    freq=$((5000 + channel * 5))
  fi
  width="$(station_width)"
  center="$(station_vht_center)"
  [ -z "$width" ] && width="20"
  echo "$freq $width ${center:-0}"
}

# Watchdog: monitors station Wi-Fi state.
# When the station disconnects or roams, pauses the AP so the Wi-Fi card PHY
# is free to scan and connect on any band without contention.
# When the station settles on a new channel/band, cleanly recreates the AP
# and restarts hostapd so clients are served seamlessly on the new frequency.
watch_station() {
  local cur_fp="" candidate_fp="" stable=0
  local applied_fp=""
  local paused=0
  applied_fp="$(station_fingerprint || true)"

  while true; do
    # Exit if hotspot was turned off by user
    if ! hotspot_on && [ "$paused" -eq 0 ]; then
      exit 0
    fi

    # Only chase the station's channel when the hotspot is actually sharing
    # the Wi-Fi connection itself (uplink == the station iface). When the
    # uplink is Ethernet/tether/something else, the AP's radio has nothing
    # to mirror -- treating "no Wi-Fi station fingerprint" as "station is
    # roaming, pause the AP" in that case would pause (and never resume) a
    # hotspot that was never meant to track Wi-Fi in the first place, since
    # a station that's deliberately not connected never produces a stable
    # fingerprint to trigger the resuming recycle_ap below.
    if [ "$(uplink_iface)" != "$(station_iface)" ]; then
      sleep 2
      continue
    fi

    cur_fp="$(station_fingerprint || true)"

    if [ -z "$cur_fp" ]; then
      # Station is disconnected / roaming / scanning.
      # To prevent holding the PHY on a stale channel (which blocks station connection),
      # pause hostapd temporarily if it was running.
      if [ "$paused" -eq 0 ] && hotspot_on; then
        cleanup_vif
        paused=1
      fi
      candidate_fp=""
      stable=0
    else
      # Station is connected to a channel.
      if [ "$cur_fp" != "$candidate_fp" ]; then
        candidate_fp="$cur_fp"
        stable=0
      else
        stable=$((stable + 1))
      fi

      # Once station connection has been stable for at least 2 ticks (4 seconds),
      # bring AP up if paused or recycle if channel changed.
      if [ "$stable" -ge 2 ]; then
        if [ "$paused" -eq 1 ] || [ "$candidate_fp" != "$applied_fp" ]; then
          if recycle_ap; then
            applied_fp="$candidate_fp"
            paused=0
          else
            sleep 2
            if recycle_ap; then
              applied_fp="$candidate_fp"
              paused=0
            fi
          fi
        fi
      fi
    fi

    sleep 2
  done
}

run_tests() {
  ensure_state
  write_hostapd_conf
  local iface phy
  iface="$(station_iface)"
  phy="phy$(iw dev "$iface" info 2>/dev/null | awk '/wiphy/ { print $2; exit }')"

  echo "--- variant C: foreground with -f logfile ---"
  cleanup_vif
  ensure_vif
  ip link set "$VIF" up 2>&1
  timeout 5 hostapd -f "$RUN_DIR/test.log" "$AP_CONF" 2>&1 | head -5
  echo "log:"; tail -3 "$RUN_DIR/test.log" 2>&1
  cleanup_vif
}

helper_dispatch() {
  case "$1" in
    status) status_text ;;
    toggle)
      if hotspot_on; then
        stop_ap
      else
        start_ap
      fi
      ;;
    set-password) set_password ;;
    set-ssid) set_ssid ;;
    set-freq-band) set_freq_band ;;
    set-channel) set_channel ;;
    list-channels) list_channels ;;
    *)
      if [ -n "${PKEXEC_UID:-}" ]; then
        echo "Subcommand '$1' is not permitted via pkexec" >&2
        exit 2
      fi
      case "$1" in
        watch) watch_station ;;
        test) run_tests ;;
        sniff)
          timeout 6 tcpdump -i "$VIF" -n -c 25 2>&1 | head -28
          ;;
        debug)
          echo "--- hostapd.conf ---"
          cat "$AP_CONF" 2>&1
          echo "--- hostapd.log ---"
          journalctl -u omarchy-hotspot --no-pager -n 15 2>&1
          echo "--- ap0 details ---"
          iw dev "$VIF" info 2>&1 || true
          echo "--- hostapd procs ---"
          pgrep -a hostapd 2>&1 || true
          ;;
        *)
          echo "usage: omarchy-hotspot-helper {status|toggle|set-password|set-ssid|set-freq-band|set-channel|list-channels|debug|test}" >&2
          exit 2
          ;;
      esac
      ;;
  esac
}

helper_dispatch "${1:-status}"
